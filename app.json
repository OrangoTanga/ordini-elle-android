{
  "expo": {
    "name": "Ordini Elly Edition",
    "slug": "ordini-elly-edition",
    "owner": "nerchio",
    "version": "1.2.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#0B1120",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.ellyedition.ordini",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1120"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Consenti a Ordini di accedere alle tue foto per aggiungere immagini ai prodotti."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00B4D8"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b92fec8d-5d1f-42b8-804c-9277dafa5a8e"
      }
    }
  }
}
